# Скопируй в .env и поменяй значения. Для локальной разработки хватит того,
# что ниже. Для продакшена см. блок PRODUCTION.

# --- Разработка ---
DEBUG=True
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://planner:planner@127.0.0.1:5433/planner
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
TIME_ZONE=Europe/Moscow

# --- PRODUCTION (пример; НЕ коммить настоящий .env) ---
# DEBUG=False
# SECRET_KEY=<сгенерируй: python -c "import secrets;print(secrets.token_urlsafe(64))">
# ALLOWED_HOSTS=api.твойдомен.ru
# DATABASE_URL=postgres://user:pass@db-host:5432/planner
# CORS_ALLOWED_ORIGINS=https://твойдомен.ru
# CSRF_TRUSTED_ORIGINS=https://твойдомен.ru,https://api.твойдомен.ru
# Если фронт и бэк на РАЗНЫХ доменах — куки должны ходить кросс-сайтом:
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None
# SECURE_SSL_REDIRECT=True
