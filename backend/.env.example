# Скопируй в .env для локальной разработки (python manage.py runserver).
# В Docker-стеке .env не нужен — значения заданы в docker-compose.local.yml.
DEBUG=True
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://planner:planner@127.0.0.1:5433/planner
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
TIME_ZONE=Europe/Moscow
